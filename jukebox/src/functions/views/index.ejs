<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head'); %>
    <link rel="stylesheet" type="text/css" href="/css/album_list.css">
</head>
<body>
    <%- include('includes/nav'); %>

    <div class="content">
        <div class="controls">
            <button id="toggleView"><img id="toggleIcon" src="/img/nav/list_icon.png" alt="Toggle View"></button>
            <a href="/album/new" id="newAlbum"><img id="newAlbum" src="/img/nav/plus_icon.png" alt="New Album"></a>
            <a href="/album/random" id="randomAlbum"><img id="randomAlbum" src="/img/nav/shuffle_icon.png" alt="Random Album"></a>
            <a href="/battle" id="battle"><img id="battle" src="/img/nav/battle_icon.png" alt="Album Battle"></a>
        </div>  
        <%- include('includes/album_grid'); %>
        <%- include('includes/album_list'); %>
    </div>

    <script src="/js/album_list.js"></script>
</body>
</html>
