<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= album.album %> by <%= album.artist %> | soundbyte</title>
    <%- include('includes/head'); %>
    <link rel="stylesheet" type="text/css" href="/css/form.css">
    <link rel="stylesheet" type="text/css" href="/css/album_list.css">
</head>
<body>
    <%- include('includes/nav'); %>

    <div class="content">
        <div class="controls">
            <a href="/album/random" id="randomAlbum"><img id="randomAlbum" src="/img/nav/shuffle_icon.png" alt="Random Album"></a>
            <a href="/battle" id="battle"><img id="battle" src="/img/nav/battle_icon.png" alt="Album Battle"></a>
        </div>  
        <!-- <h2>edit album</h2> -->
        <%- include('includes/album_form', { album: album }) %>
        <a href="/album/new" style="margin-top: 2rem;"><button type="submit">Add New Album</button></a>
    </div>

    <script src="/js/form.js"></script>
</body>
</html>
