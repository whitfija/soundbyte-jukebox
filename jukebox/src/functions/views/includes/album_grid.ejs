<div class="albums-grid" id="sortable-grid">
    <% albums.forEach((album, index) => { %>
        <div class="album-card" data-id="<%= album.albumID %>" style="--index: <%= index %>">
            <div class="album-image" style="background-image: url('<%= album.imageurl %>');">
                <div class="album-ranking">#<%= album.ranking %></div>
            </div>
            <div class="album-info">
                <h3 class="album-name">
                    <a href="/album/<%= album.albumID %>"><%= album.album %></a>
                </h3>
                <p class="album-artist">
                    <a href="/search?q=<%= encodeURIComponent(album.artist) %>&title=false&artist=true"><%= album.artist %></a>
                </p>
                <p style="display: none;" class="album-year"><%= album.year %></p>
            </div>
        </div>
    <% }); %>
</div>