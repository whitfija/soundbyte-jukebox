<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head'); %>
    <link rel="stylesheet" type="text/css" href="/css/form.css">
</head>
<body>
    <%- include('includes/nav'); %>

    <div class="content">
        <div class="login-form">
            <h2>enter password to gain full access:</h2>
